# Arquivos estáticos com cache no navegador e na CDN do Netlify (compressão Brotli/gzip é automática)
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
